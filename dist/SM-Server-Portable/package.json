{
    "name":  "service-manager",
    "version":  "1.0.0",
    "description":  "Service Manager - Remote Device \u0026 Camera Control",
    "author":  "ServiceManager",
    "main":  "main.js",
    "scripts":  {
                    "start":  "electron . --role=manager",
                    "dist":  "electron-builder"
                },
    "dependencies":  {
                         "express":  "^4.19.2",
                         "nat-upnp-2":  "^3.0.3",
                         "node-onvif":  "^0.1.7"
                     },
    "devDependencies":  {
                            "electron":  "^44.0.0",
                            "electron-builder":  "^26.15.3"
                        },
    "build":  {
                  "appId":  "com.servicemanager.app",
                  "productName":  "Service Manager",
                  "directories":  {
                                      "output":  "dist"
                                  },
                  "files":  [
                                "main.js",
                                "preload.js",
                                "setup.html",
                                "src/**/*",
                                "dashboard/**/*",
                                "client/**/*"
                            ],
                  "win":  {
                              "target":  "nsis",
                              "icon":  "build/icon.png"
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "perMachine":  true,
                               "runAfterFinish":  true,
                               "include":  "build/installer.nsh",
                               "allowToChangeInstallationDirectory":  true
                           },
                  "extraResources":  [
                                         {
                                             "from":  "resources/go2rtc.exe",
                                             "to":  "go2rtc.exe"
                                         }
                                     ]
              }
}
