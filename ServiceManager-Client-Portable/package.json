{
  "name": "service-manager",
  "version": "1.0.1",
  "description": "Service Manager - Remote Device & Camera Control",
  "author": "ServiceManager",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist-installer": "electron-builder --win nsis"
  },
  "dependencies": {
    "express": "^4.19.2",
    "nat-upnp-2": "^3.0.3"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.servicemanager.app",
    "productName": "Service Manager",
    "copyright": "Service Manager",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "src/**/*",
      "dashboard/**/*",
      "client/**/*"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "executableName": "Service Manager",
      "artifactName": "Service Manager Setup.exe"
    },
    "portable": {
      "artifactName": "Service Manager Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Service Manager",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "extraResources": [
      { "from": "resources/go2rtc.exe", "to": "go2rtc.exe" }
    ]
  }
}
