{
  "name": "ipc",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start_dev.js",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('.next', {recursive:true, force:true});\"",
    "search": "node search.js",
    "test-probe": "node test_probe.js",
    "test-api": "node test_api.js",
    "test-onvif": "node test_onvif.js",
    "run-onvif-test": "node run_onvif_test.js",
    "kill-ports": "node kill_ports.js",
    "test-double": "node test_probe_double.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "fix-path": "^5.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "hls.js": "^1.5.15",
    "lucide-react": "^1.16.0",
    "nat-upnp-2": "^3.0.3",
    "next": "16.2.6",
    "node-onvif": "^0.1.7",
    "peerjs": "^1.5.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "pnpm": {
    "approvedBuilds": [
      "sharp",
      "unrs-resolver",
      "electron-winstaller"
    ]
  },
  "main": "src/main/main.js",
  "build": {
    "appId": "com.ipc.servicemanager",
    "productName": "Service Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/system_icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "runAfterFinish": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "resources/go2rtc.exe",
        "to": "go2rtc.exe"
      },
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
